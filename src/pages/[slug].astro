---
import { themeTemplates } from 'virtual:theme-templates';
import { createContextAlongside } from '@/lib/context';
import { prepareNotFoundData, preparePageData } from '@/lib/page-data';
import { isKnownMissingSlug, markSlugMissing } from '@/lib/scanner-protection';
import { and, eq } from 'drizzle-orm';
import { schema } from '@/db';
import { getCookieValue } from '@/lib/auth';

const { slug } = Astro.params;

// Remove .html extension if present
const cleanSlug = slug?.replace(/\.html$/, '') || '';
if (!cleanSlug) return Astro.redirect('/');

// Negative cache: a slug recently resolved to "no page exists" skips the
// contents lookup entirely. Logged-in requests bypass it so a freshly
// created page is never hidden from its owner (30s TTL otherwise).
const loggedIn = !!getCookieValue(Astro.request.headers.get('cookie'), '__typecho_uid');
if (!loggedIn && await isKnownMissingSlug(cleanSlug)) {
  return Astro.rewrite('/404');
}

// Resolve auth and the page row in parallel. The middleware has already
// installed the request-scoped DB core for normal page requests.
const [ctx, pageRow] = await createContextAlongside(
  Astro.locals,
  Astro.request,
  db => db.query.contents.findFirst({
    where: and(eq(schema.contents.slug, cleanSlug), eq(schema.contents.type, 'page')),
  }),
);
if (!loggedIn && !pageRow) markSlugMissing(cleanSlug);
const { options } = ctx;

// Select theme component
const activeTheme = options.theme || 'typecho-theme-warm';
const templates = themeTemplates[activeTheme] ?? {};
const defaultTemplates = themeTemplates['typecho-theme-warm']!;
const customPageTemplate = pageRow?.template
  ? templates.PageTemplates?.[pageRow.template]?.Component
  : undefined;
let Component = customPageTemplate ?? templates.Page ?? defaultTemplates.Page!;

// Prepare data
const suppliedPassword = Astro.url.searchParams.get('password');
const unapprovedCommentToken = getCookieValue(
  Astro.request.headers.get('cookie'),
  '__typecho_unapproved_comment',
);
let result = await preparePageData(ctx, cleanSlug, Astro.request.url, suppliedPassword, pageRow, unapprovedCommentToken);
if (result instanceof Response) {
  if (result.status !== 404) return result;
  Astro.response.status = 404;
  result = await prepareNotFoundData(ctx, Astro.request.url);
  Component = templates.NotFound ?? defaultTemplates.NotFound!;
}
---
<Component {...result} />
