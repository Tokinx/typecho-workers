---
import Admin from '@/layouts/Admin.astro';
import { createContext, requireAuth } from '@/lib/context';
import { hasPermission } from '@/lib/auth';

const ctx = await createContext(Astro.locals, Astro.request);
const authCheck = requireAuth(ctx);
if (authCheck) return authCheck;

if (!hasPermission(ctx.user!.group || 'visitor', 'administrator')) {
  return new Response('Forbidden', { status: 403 });
}

const { options, urls, user, csrfToken } = ctx;

// Convert commentsPostTimeout from seconds to days for display
const commentsPostTimeoutDays = options.commentsPostTimeout
  ? Math.round(Number(options.commentsPostTimeout) / (24 * 3600))
  : 14;

// Convert commentsPostInterval from seconds to minutes for display
const commentsPostIntervalMinutes = options.commentsPostInterval
  ? Math.round(Number(options.commentsPostInterval) / 60)
  : 1;
const commentsMaxNestingLevels = Math.min(7, Math.max(2, Number(options.commentsMaxNestingLevels) || 5));
---
<Admin title="评论设置" options={options} urls={urls} user={user} activeMenu="options-discussion" pluginCtx={ctx}>
  <div class="col-mb-12 col-tb-8 col-tb-offset-2" role="form">
    <form method="post" action="/api/admin/options">
      <input type="hidden" name="_" value={csrfToken} />
      <ul class="typecho-option" id="typecho-option-item-commentDateFormat-0">
        <li>
          <label class="typecho-label" for="commentDateFormat-0-1">评论日期格式</label>
          <input id="commentDateFormat-0-1" name="commentDateFormat" type="text" class="w-40 mono"
            value={options.commentDateFormat || 'F jS, Y'} />
          <p class="description">这是一个默认的格式,当你在模板中调用显示评论日期方法时, 如果没有指定日期格式, 将按照此格式输出.<br />具体写法请参考 <a href="https://www.php.net/manual/zh/function.date.php" target="_blank" rel="noopener noreferrer">PHP 日期格式写法</a>.</p>
        </li>
      </ul>

      <ul class="typecho-option" id="typecho-option-item-commentsListSize-1">
        <li>
          <label class="typecho-label" for="commentsListSize-0-2">评论列表数目</label>
          <input type="number" id="commentsListSize-0-2" name="commentsListSize" class="w-20"
            value={options.commentsListSize || '10'} />
          <p class="description">此数目用于指定显示在侧边栏中的评论列表数目.</p>
        </li>
      </ul>

      <ul class="typecho-option" id="typecho-option-item-commentsShow-2">
        <li>
          <label class="typecho-label">评论显示</label>
          <span class="multiline"><input type="checkbox" id="commentsShow-commentsShowCommentOnly" name="commentsShowCommentOnly" value="1"
            checked={!!options.commentsShowCommentOnly && options.commentsShowCommentOnly !== '0'} /><label for="commentsShow-commentsShowCommentOnly">仅显示评论, 不显示 Pingback 和 Trackback</label></span>
          <span class="multiline"><input type="checkbox" id="commentsShow-commentsMarkdown" name="commentsMarkdown" value="1"
            checked={!!options.commentsMarkdown && options.commentsMarkdown !== '0'} /><label for="commentsShow-commentsMarkdown">在评论中使用 Markdown 语法</label></span>
          <span class="multiline"><input type="checkbox" id="commentsShow-commentsShowUrl" name="commentsShowUrl" value="1"
            checked={!!options.commentsShowUrl} /><label for="commentsShow-commentsShowUrl">评论者名称显示时自动加上其个人主页链接</label></span>
          <span class="multiline"><input type="checkbox" id="commentsShow-commentsUrlNofollow" name="commentsUrlNofollow" value="1"
            checked={!!options.commentsUrlNofollow && options.commentsUrlNofollow !== '0'} /><label for="commentsShow-commentsUrlNofollow">对评论者个人主页链接使用 <a href="https://en.wikipedia.org/wiki/Nofollow">nofollow 属性</a></label></span>
          <span class="multiline"><input type="checkbox" id="commentsShow-commentsAvatar" name="commentsAvatar" value="1"
            checked={!!options.commentsAvatar} /><label for="commentsShow-commentsAvatar">启用 <a href="https://gravatar.com">Gravatar</a> 头像服务, 最高显示评级为</label>
            <select name="commentsAvatarRating" id="commentsShow-commentsAvatarRating">
              <option value="G" selected={!options.commentsAvatarRating || options.commentsAvatarRating === 'G'}>G - 普通</option>
              <option value="PG" selected={options.commentsAvatarRating === 'PG'}>PG - 13岁以上</option>
              <option value="R" selected={options.commentsAvatarRating === 'R'}>R - 17岁以上成人</option>
              <option value="X" selected={options.commentsAvatarRating === 'X'}>X - 限制级</option>
            </select>
            <label for="commentsShow-commentsAvatarRating">的头像</label>
          </span>
          <span class="multiline"><input type="checkbox" id="commentsShow-commentsPageBreak" name="commentsPageBreak" value="1"
            checked={!!options.commentsPageBreak && options.commentsPageBreak !== '0'} /><label for="commentsShow-commentsPageBreak">启用分页, 并且每页显示</label>
            <input type="number" id="commentsShow-commentsPageSize" name="commentsPageSize" class="text num text-s"
              value={options.commentsPageSize || '20'} />
            <label for="commentsShow-commentsPageSize">篇评论, 在列出时将</label>
            <select name="commentsPageDisplay" id="commentsShow-commentsPageDisplay">
              <option value="first" selected={options.commentsPageDisplay === 'first'}>第一页</option>
              <option value="last" selected={!options.commentsPageDisplay || options.commentsPageDisplay === 'last'}>最后一页</option>
            </select>
            <label for="commentsShow-commentsPageDisplay">作为默认显示</label>
          </span>
          <span class="multiline"><input type="checkbox" id="commentsShow-commentsThreaded" name="commentsThreaded" value="1"
            checked={!!options.commentsThreaded && options.commentsThreaded !== '0'} /><label for="commentsShow-commentsThreaded">启用评论回复, 以</label>
            <input id="commentsShow-commentsMaxNestingLevels" name="commentsMaxNestingLevels" type="number"
              class="text num text-s" value={String(commentsMaxNestingLevels)} />
            <label for="commentsShow-commentsMaxNestingLevels">层作为每个评论最多的回复层数</label>
          </span>
          <span class="multiline">将
            <select name="commentsOrder" id="commentsShow-commentsOrder">
              <option value="DESC" selected={options.commentsOrder === 'DESC'}>较新的</option>
              <option value="ASC" selected={!options.commentsOrder || options.commentsOrder === 'ASC'}>较旧的</option>
            </select>
            <label for="commentsShow-commentsOrder">的评论显示在前面</label>
          </span>
        </li>
      </ul>

      <ul class="typecho-option" id="typecho-option-item-commentsPost-3">
        <li>
          <label class="typecho-label">评论提交</label>
          <span class="multiline"><input type="checkbox" id="commentsPost-commentsRequireModeration" name="commentsRequireModeration" value="1"
            checked={!!options.commentsRequireModeration && options.commentsRequireModeration !== '0'} /><label for="commentsPost-commentsRequireModeration">所有评论必须经过审核</label></span>
          <span class="multiline"><input type="checkbox" id="commentsPost-commentsWhitelist" name="commentsWhitelist" value="1"
            checked={!!options.commentsWhitelist && options.commentsWhitelist !== '0'} /><label for="commentsPost-commentsWhitelist">评论者之前须有评论通过了审核</label></span>
          <span class="multiline"><input type="checkbox" id="commentsPost-commentsRequireMail" name="commentsRequireMail" value="1"
            checked={!!options.commentsRequireMail && options.commentsRequireMail !== '0'} /><label for="commentsPost-commentsRequireMail">必须填写邮箱</label></span>
          <span class="multiline"><input type="checkbox" id="commentsPost-commentsRequireUrl" name="commentsRequireUrl" value="1"
            checked={!!options.commentsRequireURL && options.commentsRequireURL !== '0'} /><label for="commentsPost-commentsRequireUrl">必须填写网址</label></span>
          <span class="multiline"><input type="checkbox" id="commentsPost-commentsCheckReferer" name="commentsCheckReferer" value="1"
            checked={!!options.commentsCheckReferer && options.commentsCheckReferer !== '0'} /><label for="commentsPost-commentsCheckReferer">检查评论来源页 URL 是否与文章链接一致</label></span>
          <span class="multiline"><input type="checkbox" id="commentsPost-commentsAntiSpam" name="commentsAntiSpam" value="1"
            checked={!!options.commentsAntiSpam && options.commentsAntiSpam !== '0'} /><label for="commentsPost-commentsAntiSpam">开启反垃圾保护</label></span>
          <span class="multiline"><input type="checkbox" id="commentsPost-commentsAutoClose" name="commentsAutoClose" value="1"
            checked={!!options.commentsAutoClose && options.commentsAutoClose !== '0'} /><label for="commentsPost-commentsAutoClose">在文章发布</label>
            <input type="number" id="commentsPost-commentsPostTimeout" name="commentsPostTimeout" class="text num text-s"
              value={String(commentsPostTimeoutDays)} />
            <label for="commentsPost-commentsPostTimeout">天以后自动关闭评论</label></span>
          <span class="multiline"><input type="checkbox" id="commentsPost-commentsPostIntervalEnable" name="commentsPostIntervalEnable" value="1"
            checked={!!options.commentsPostIntervalEnable && options.commentsPostIntervalEnable !== '0'} /><label for="commentsPost-commentsPostIntervalEnable">同一 IP 发布评论的时间间隔限制为</label>
            <input type="number" id="commentsPost-commentsPostInterval" name="commentsPostInterval" class="text num text-s"
              value={String(commentsPostIntervalMinutes)} />
            <label for="commentsPost-commentsPostInterval">分钟</label></span>
        </li>
      </ul>

      <ul class="typecho-option" id="typecho-option-item-commentsHTMLTagAllowed-4">
        <li>
          <label class="typecho-label" for="commentsHTMLTagAllowed-0-5">允许使用的HTML标签和属性</label>
          <textarea id="commentsHTMLTagAllowed-0-5" name="commentsHTMLTagAllowed" class="mono" rows="3">{options.commentsHTMLTagAllowed ?? '<a href=""> <img src=""> <em> <strong> <cite> <blockquote> <code> <pre>'}</textarea>
          <p class="description">默认的用户评论不允许填写任何的HTML标签, 你可以在这里填写允许使用的HTML标签.<br />比如: <code>&lt;a href=&quot;&quot;&gt; &lt;img src=&quot;&quot;&gt; &lt;blockquote&gt;</code></p>
        </li>
      </ul>

      <ul class="typecho-option" id="typecho-option-item-mailEnabled-5">
        <li>
          <label class="typecho-label"><input type="checkbox" id="mailEnabled-0-6" name="mailEnabled" value="1"
            checked={Number(options.mailEnabled) === 1} />启用邮件通知</label>
          <p class="description">启用后，系统才会实际发送邮件。</p>
        </li>
      </ul>
      <ul class="typecho-option" id="typecho-option-item-mailFrom-7" style={Number(options.mailEnabled) !== 1 ? 'display:none' : undefined} data-mail-settings="true">
        <li>
          <label class="typecho-label" for="mailFrom-0-8">发件邮箱</label>
          <input id="mailFrom-0-8" name="mailFrom" type="email" class="text" value={options.mailFrom || ''} />
        </li>
      </ul>
      <ul class="typecho-option" id="typecho-option-item-mailFromName-8" style={Number(options.mailEnabled) !== 1 ? 'display:none' : undefined} data-mail-settings="true">
        <li>
          <label class="typecho-label" for="mailFromName-0-9">发件人名称</label>
          <input id="mailFromName-0-9" name="mailFromName" type="text" class="text" value={options.mailFromName || ''} />
        </li>
      </ul>
      <ul class="typecho-option" id="typecho-option-item-commentEmailEnabled-6">
        <li>
          <label class="typecho-label"><input type="checkbox" id="commentEmailEnabled-0-7" name="commentEmailEnabled" value="1"
            checked={Number(options.commentEmailEnabled) === 1} />有新评论时发送邮件通知</label>
          <p class="description">通知文章作者和父评论作者。</p>
        </li>
      </ul>
      <ul class="typecho-option" id="typecho-option-item-commentEmailReplyEnabled-9">
        <li>
          <label class="typecho-label"><input type="checkbox" id="commentEmailReplyEnabled-0-10" name="commentEmailReplyEnabled" value="1"
            checked={Number(options.commentEmailReplyEnabled) !== 0} />包含评论回复通知</label>
          <p class="description">当有人回复评论时，通知被回复者</p>
        </li>
      </ul>

      <ul class="typecho-option typecho-option-submit" id="typecho-option-item-submit-10">
        <li>
          <button type="submit" class="btn primary">保存设置</button>
        </li>
      </ul>
    </form>
  </div>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var toggle = document.getElementById('mailEnabled-0-6');
      if (!toggle) return;
      var updateMailSettings = function () {
        document.querySelectorAll('[data-mail-settings]').forEach(function (element) {
          element.style.display = toggle.checked ? '' : 'none';
        });
      };
      toggle.addEventListener('change', updateMailSettings);
      updateMailSettings();
    });
  </script>
</Admin>
