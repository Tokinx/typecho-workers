---
import Admin from '@/layouts/Admin.astro';
import { createContext, requireAuth } from '@/lib/context';
import { hasPermission } from '@/lib/auth';
import { and, desc, eq } from 'drizzle-orm';
import { schema } from '@/db';

const ctx = await createContext(Astro.locals, Astro.request);
const authCheck = requireAuth(ctx);
if (authCheck) return authCheck;

if (!hasPermission(ctx.user!.group || 'visitor', 'editor')) {
  return new Response('Forbidden', { status: 403 });
}

const { db, options, urls, user, csrfToken } = ctx;

// Editing
const editMid = Astro.url.searchParams.get('mid');
const editId = editMid ? parseInt(editMid, 10) : 0;
const [tags, editRows] = await db.batch([
  db.select().from(schema.metas)
    .where(eq(schema.metas.type, 'tag'))
    .orderBy(desc(schema.metas.mid)),
  db.select().from(schema.metas)
    .where(and(eq(schema.metas.mid, editId || -1), eq(schema.metas.type, 'tag')))
    .limit(1),
]);
const editTag: any = editRows[0] ?? null;
const pageTitle = editTag ? `编辑标签 ${editTag.name || '未命名标签'}` : '管理标签';

function tagSize(count: number | null): 0 | 5 | 10 | 20 | 30 {
  const value = Number(count) || 0;
  if (value < 5) return 5;
  if (value < 10) return 10;
  if (value < 20) return 20;
  if (value < 30) return 30;
  return 0;
}
---
<Admin title={pageTitle} options={options} urls={urls} user={user} activeMenu="manage-tags" bodyClass="manage-metas" pluginCtx={ctx}>
  <div class="col-mb-12 col-tb-8" role="main">
    <form method="post" name="manage_tags" class="operate-form">
      <input type="hidden" name="_" value={csrfToken} />
      <div class="typecho-list-operate">
        <div class="operate">
          <label><i class="sr-only">全选</i><input type="checkbox" class="typecho-table-select-all" /></label>
          <div class="btn-group btn-drop">
            <button class="btn dropdown-toggle btn-s" type="button"><i class="sr-only">操作</i>选中项 <i class="i-caret-down"></i></button>
            <ul class="dropdown-menu">
              <li><a href="/api/admin/meta?action=delete&type=tag">删除</a></li>
              <li><a href="/api/admin/meta?action=refresh&type=tag">刷新</a></li>
              <li class="multiline">
                <button type="button" class="btn merge btn-s">合并到</button>
                <input type="text" name="merge" class="text-s" aria-label="合并目标标签" />
              </li>
            </ul>
          </div>
        </div>
      </div>

      {tags.length > 0 ? (
        <ul class="typecho-list-notable tag-list">
          {tags.map((tag) => (
            <li class={`size-${tagSize(tag.count)}`} id={`tag-${tag.mid}`}>
              <input type="checkbox" value={String(tag.mid)} name="mid[]" />
              <span rel={`/admin/manage-tags?mid=${tag.mid}`}>{tag.name}</span>
              <a class="tag-edit-link" href={`/admin/manage-tags?mid=${tag.mid}`} title={`编辑 ${tag.name}`}><i class="i-edit"></i></a>
            </li>
          ))}
        </ul>
      ) : (
        <ul class="tag-list">
          <li class="none">没有任何标签</li>
        </ul>
      )}
    </form>
  </div>

  <div class="col-mb-12 col-tb-4" role="form">
    <div class="typecho-mini-panel" data-editing={editTag ? 'true' : 'false'}>
      <form method="post" action="/api/admin/meta">
        <input type="hidden" name="_" value={csrfToken} />
        <input type="hidden" name="action" value={editTag ? 'update' : 'create'} />
        <input type="hidden" name="type" value="tag" />
        {editTag && <input type="hidden" name="mid" value={String(editTag.mid)} />}

        <ul class="typecho-option">
          <li>
            <label for="name" class="typecho-label">标签名称 *</label>
            <input type="text" id="name" name="name" class="text w-100" value={editTag?.name || ''} required />
            <p class="description">这是标签在站点中显示的名称.可以使用中文,如 "地球".</p>
          </li>
        </ul>
        <ul class="typecho-option">
          <li>
            <label for="slug" class="typecho-label">标签缩略名</label>
            <input type="text" id="slug" name="slug" class="text w-100" value={editTag?.slug || ''} placeholder="留空自动生成" />
            <p class="description">标签缩略名用于创建友好的链接形式, 如果留空则默认使用标签名称.</p>
          </li>
        </ul>

        <p>
          <button type="submit" class="btn primary">{editTag ? '更新标签' : '增加标签'}</button>
          {editTag && <a href="/admin/manage-tags" class="btn">取消</a>}
        </p>
      </form>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      $('.dropdown-menu button.merge').on('click', function () {
        var form = $(this).closest('form.operate-form');
        if ($('input[type=checkbox]:checked', form).length === 0) {
          alert('请先选择要操作的项目');
          return;
        }
        if (!$('input[name="merge"]', form).val()) {
          alert('请填写合并目标标签');
          return;
        }

        form.attr('action', '/api/admin/meta?action=merge&type=tag').submit();
      });

      if ($('.typecho-mini-panel').data('editing') === 'true') {
        $('.typecho-mini-panel').effect('highlight', '#AACB36');
      }
    });
  </script>
</Admin>
