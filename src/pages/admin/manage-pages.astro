---
import Admin from '@/layouts/Admin.astro';
import { createContext, requireAuth } from '@/lib/context';
import { hasPermission } from '@/lib/auth';
import { eq, sql, desc } from 'drizzle-orm';
import { schema } from '@/db';
import { formatDate, buildPermalink } from '@/lib/content';
import { loadQueryCache } from '@/lib/query-cache';

const ctx = await createContext(Astro.locals, Astro.request);
const authCheck = requireAuth(ctx);
if (authCheck) return authCheck;
if (!hasPermission(ctx.user!.group || 'visitor', 'editor')) {
  return new Response('Forbidden', { status: 403 });
}

const { db, options, urls, user, csrfToken } = ctx;
const keywords = Astro.url.searchParams.get('keywords') || '';
const rawParent = Astro.url.searchParams.get('parent') || '';
const parentId = keywords || !rawParent ? 0 : Number(rawParent);
if (!keywords && rawParent && (!/^\d+$/.test(rawParent) || !Number.isSafeInteger(parentId))) {
  return new Response('页面不存在', { status: 404 });
}

const conditions: any[] = [
  sql`${schema.contents.type} IN ('page', 'page_draft')`,
];
if (keywords) {
  conditions.push(sql`${schema.contents.title} LIKE ${'%' + keywords + '%'}`);
} else {
  conditions.push(sql`coalesce(${schema.contents.parent}, 0) = ${parentId}`);
}

const pageColumns = {
  cid: schema.contents.cid,
  title: schema.contents.title,
  slug: schema.contents.slug,
  type: schema.contents.type,
  status: schema.contents.status,
  created: schema.contents.created,
  commentsNum: schema.contents.commentsNum,
  authorId: schema.contents.authorId,
  parent: schema.contents.parent,
  order: schema.contents.order,
};
const loadPageList = async () => {
  const [pageRows, childCountRows, parentRows] = await db.batch([
    db.select({
      content: pageColumns,
      authorUid: schema.users.uid,
      authorName: schema.users.name,
      authorScreenName: schema.users.screenName,
    }).from(schema.contents)
      .leftJoin(schema.users, eq(schema.contents.authorId, schema.users.uid))
      .where(sql.join(conditions, sql` AND `))
      .orderBy(schema.contents.order, desc(schema.contents.created)),
    db.select({
      parent: schema.contents.parent,
      count: sql<number>`count(*)`,
    }).from(schema.contents)
      .where(sql`${schema.contents.type} IN ('page', 'page_draft')`)
      .groupBy(schema.contents.parent),
    parentId > 0
      ? db.select({ cid: schema.contents.cid, title: schema.contents.title, parent: schema.contents.parent })
        .from(schema.contents)
        .where(sql`${schema.contents.cid} = ${parentId} AND ${schema.contents.type} IN ('page', 'page_draft')`)
        .limit(1)
      : db.select({ cid: schema.contents.cid, title: schema.contents.title, parent: schema.contents.parent })
        .from(schema.contents)
        .where(sql`1 = 0`),
  ]);
  return { pageRows, childCountRows, parentPage: parentRows[0] ?? null };
};
const pageListData = keywords
  ? await loadPageList()
  : await loadQueryCache(ctx, {
    domain: 'admin-content',
    scope: 'viewer',
    key: { view: 'pages', parent: parentId },
  }, loadPageList);
const { pageRows, childCountRows, parentPage } = pageListData;
const pages = pageRows.map(row => row.content);
const childCounts = new Map(childCountRows.map(row => [Number(row.parent) || 0, Number(row.count)]));
if (parentId > 0 && !parentPage) {
  return new Response('页面不存在', { status: 404 });
}
const pageListTitle = parentPage ? `管理 ${parentPage.title || '无标题'} 的子页面` : '管理独立页面';
const parentBackHref = parentPage?.parent
  ? `/admin/manage-pages?parent=${parentPage.parent}`
  : '/admin/manage-pages';
const authorMap = new Map(pageRows
  .filter(row => row.authorUid !== null)
  .map(row => [row.authorUid!, {
    uid: row.authorUid!,
    name: row.authorName,
    screenName: row.authorScreenName,
  }]));
---
<Admin
  title={pageListTitle}
  addLink={parentId > 0 ? `/admin/write-page?parent=${parentId}` : '/admin/write-page'}
  options={options}
  urls={urls}
  user={user}
  activeMenu="manage-pages"
  pluginCtx={ctx}
>
  <div class="col-mb-12 typecho-list">
    <form method="get" class="typecho-list-operate">
        <div class="operate">
          <label><i class="sr-only">全选</i><input type="checkbox" class="typecho-table-select-all" /></label>
          <div class="btn-group btn-drop">
            <button class="btn dropdown-toggle btn-s" type="button"><i class="sr-only">操作</i>选中项 <i class="i-caret-down"></i></button>
            <ul class="dropdown-menu">
              <li><a href="/api/admin/content-batch?do=delete&type=page">删除</a></li>
              <li><a href="/api/admin/content-batch?do=mark&status=publish&type=page">标记为<strong>公开</strong></a></li>
              <li><a href="/api/admin/content-batch?do=mark&status=hidden&type=page">标记为<strong>隐藏</strong></a></li>
            </ul>
          </div>
        </div>
        <div class="search" role="search">
          {parentPage && <a href={parentBackHref}>&laquo; 返回父级页面</a>}
          {keywords && <a href="/admin/manage-pages">&laquo; 取消筛选</a>}
          <input type="text" class="text-s" placeholder="请输入关键字" value={keywords} name="keywords" />
          <button type="submit" class="btn btn-s">筛选</button>
        </div>
    </form>

    <form method="post" name="manage_pages" class="operate-form" data-page-parent={String(parentId)}>
      <input type="hidden" name="_" value={csrfToken} />
      <table class="typecho-list-table">
          <colgroup>
            <col width="3%" class="kit-hidden-mb" />
            <col width="6%" class="kit-hidden-mb" />
            <col width="42%" />
            <col width="18%" />
            <col width="" class="kit-hidden-mb" />
            <col width="16%" />
          </colgroup>
          <thead>
            <tr class="nodrag">
              <th class="kit-hidden-mb"></th>
              <th class="kit-hidden-mb"></th>
              <th>标题</th>
              <th>子页面</th>
              <th class="kit-hidden-mb">作者</th>
              <th>日期</th>
            </tr>
          </thead>
          <tbody>
            {pages.length === 0 ? (
              <tr>
                <td colspan="6" class="none">没有任何页面</td>
              </tr>
            ) : (
              pages.map((pg) => {
                const author = authorMap.get(pg.authorId || 0);
                const isDraft = pg.type === 'page_draft';
                const childCount = childCounts.get(pg.cid) || 0;
                return (
                  <tr id={`${pg.type}-${pg.cid}`}>
                    <td class="kit-hidden-mb"><input type="checkbox" value={String(pg.cid)} name="cid[]" /></td>
                    <td class="kit-hidden-mb">
                      <a href={`/admin/manage-comments?cid=${pg.cid}`}
                        class="balloon-button size-small"
                        title={`${pg.commentsNum || 0} 评论`}>{pg.commentsNum || 0}</a>
                    </td>
                    <td>
                      <a href={`/admin/write-page?cid=${pg.cid}`}>{pg.title || '无标题'}</a>
                      {isDraft && <em class="status">草稿</em>}
                      {pg.status === 'hidden' && <em class="status">隐藏</em>}
                      <a href={`/admin/write-page?cid=${pg.cid}`} title={`编辑 ${pg.title}`}><i class="i-edit"></i></a>
                      {!isDraft && (
                        <a href={buildPermalink({ cid: pg.cid, slug: pg.slug, type: pg.type, created: pg.created }, urls.siteUrl, undefined, options.pagePattern as string | undefined)}
                          title={`浏览 ${pg.title}`}><i class="i-exlink"></i></a>
                      )}
                    </td>
                    <td>
                      {childCount > 0 ? (
                        <a href={`/admin/manage-pages?parent=${pg.cid}`}>
                          {childCount === 1 ? '一个页面' : `${childCount}个页面`}
                        </a>
                      ) : (
                        <a href={`/admin/write-page?parent=${pg.cid}`}>新增</a>
                      )}
                    </td>
                    <td class="kit-hidden-mb">{author?.screenName || author?.name || '未知'}</td>
                    <td>{formatDate(pg.created || 0, 'Y-m-d', options.timezone)}</td>
                  </tr>
                );
              })
            )}
          </tbody>
      </table>
    </form>
  </div>
  {!keywords && (
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        var table = $('.typecho-list-table').tableDnD({
          onDrop: function () {
            var ids = [];
            var form = table.closest('form.operate-form');

            $('input[type=checkbox]', table).each(function () {
              ids.push($(this).val());
            });

            $.post('/api/admin/content-batch?do=sort&type=page', $.param({
              cid: ids,
              parent: form.data('page-parent'),
              _: $('input[name="_"]', form).val()
            }));
          }
        });
      });
    </script>
  )}
</Admin>
