---
import Admin from '@/layouts/Admin.astro';
import { createContext, requireAuth } from '@/lib/context';
import { hasPermission } from '@/lib/auth';
import { and, eq, lt } from 'drizzle-orm';
import { schema } from '@/db';

const ctx = await createContext(Astro.locals, Astro.request);
const authCheck = requireAuth(ctx);
if (authCheck) return authCheck;

if (!hasPermission(ctx.user!.group || 'visitor', 'administrator')) {
  return new Response('Forbidden', { status: 403 });
}

const { db, options, urls, user, csrfToken } = ctx;
const frontPageSetting = String(options.frontPage || 'recent');
const frontPageParts = frontPageSetting.split(':');
const selectedFrontPageCid = frontPageParts[0] === 'page' ? Number(frontPageParts[1]) : 0;
const frontPageRows = await db.select({ cid: schema.contents.cid, title: schema.contents.title })
  .from(schema.contents)
  .where(and(
    eq(schema.contents.type, 'page'),
    eq(schema.contents.status, 'publish'),
    lt(schema.contents.created, Math.floor(Date.now() / 1000)),
  ));
const hasSelectedFrontPage = frontPageRows.some((page) => page.cid === selectedFrontPageCid);
const frontPageType = hasSelectedFrontPage ? 'page' : 'recent';
---
<Admin title="阅读设置" options={options} urls={urls} user={user} activeMenu="options-reading" pluginCtx={ctx}>
  <div class="col-mb-12 col-tb-8 col-tb-offset-2" role="form">
    <form method="post" action="/api/admin/options">
      <input type="hidden" name="_" value={csrfToken} />
      <ul class="typecho-option" id="typecho-option-item-postDateFormat-0">
        <li>
          <label class="typecho-label" for="postDateFormat-0-1">文章日期格式</label>
          <input id="postDateFormat-0-1" name="postDateFormat" type="text" class="w-40 mono"
            value={options.postDateFormat || 'Y-m-d'} />
          <p class="description">此格式用于指定显示在文章归档中的日期默认显示格式.<br />在某些主题中这个格式可能不会生效, 因为主题作者可以自定义日期格式.<br />请参考 <a href="https://www.php.net/manual/zh/function.date.php" target="_blank" rel="noopener noreferrer">PHP 日期格式写法</a>.</p>
        </li>
      </ul>
      <ul class="typecho-option" id="typecho-option-item-frontPage-1">
        <li>
          <label class="typecho-label">站点首页</label>
          <span class="multiline">
            <input type="radio" name="frontPage" value="recent" id="frontPage-recent" checked={frontPageType === 'recent'} />
            <label for="frontPage-recent">显示最新发布的文章</label>
          </span>
          {frontPageRows.length > 0 && (
            <span class="multiline">
              <input type="radio" name="frontPage" value="page" id="frontPage-page" checked={frontPageType === 'page'} />
              <label for="frontPage-page">使用</label>
              <select name="frontPagePage" id="frontPage-frontPagePage">
                {frontPageRows.map((page) => (
                  <option value={String(page.cid)} selected={page.cid === selectedFrontPageCid}>{page.title || '无标题'}</option>
                ))}
              </select>
              <label for="frontPage-frontPagePage">页面作为首页</label>
            </span>
          )}
        </li>
      </ul>
      <ul class="typecho-option" id="typecho-option-item-postsListSize-2">
        <li>
          <label class="typecho-label" for="postsListSize-0-3">文章列表数目</label>
          <input id="postsListSize-0-3" name="postsListSize" type="number" class="w-20"
            value={options.postsListSize || '10'} />
          <p class="description">此数目用于指定显示在侧边栏中的文章列表数目.</p>
        </li>
      </ul>
      <ul class="typecho-option" id="typecho-option-item-pageSize-3">
        <li>
          <label class="typecho-label" for="pageSize-0-4">每页文章数目</label>
          <input id="pageSize-0-4" name="pageSize" type="number" class="w-20"
            value={options.pageSize || '5'} />
          <p class="description">此数目用于指定文章归档输出时每页显示的文章数目.</p>
        </li>
      </ul>
      <ul class="typecho-option" id="typecho-option-item-feedFullText-4">
        <li>
          <label class="typecho-label">聚合全文输出</label>
          <span><input type="radio" name="feedFullText" value="0" id="feedFullText-0" checked={Number(options.feedFullText) !== 1} /><label for="feedFullText-0">仅输出摘要</label></span>
          <span><input type="radio" name="feedFullText" value="1" id="feedFullText-1" checked={Number(options.feedFullText) === 1} /><label for="feedFullText-1">全文输出</label></span>
          <p class="description">如果你不希望在聚合中输出文章全文,请使用仅输出摘要选项.<br />摘要的文字取决于你在文章中使用分隔符的位置.</p>
        </li>
      </ul>

      <ul class="typecho-option typecho-option-submit" id="typecho-option-item-submit-5">
        <li>
          <button type="submit" class="btn primary">保存设置</button>
        </li>
      </ul>
    </form>
  </div>
</Admin>
