---
import Admin from '@/layouts/Admin.astro';
import { createContext, requireAuth } from '@/lib/context';
import { hasPermission } from '@/lib/auth';
import { eq, and, inArray } from 'drizzle-orm';
import { schema } from '@/db';
import { formatDate } from '@/lib/content';
import { renderPermalinkPattern } from '@/lib/permalink-pattern';
import { applyFilterSafely } from '@/lib/plugin';
import { themeTemplates } from 'virtual:theme-templates';

const ctx = await createContext(Astro.locals, Astro.request);
const authCheck = requireAuth(ctx);
if (authCheck) return authCheck;
if (!hasPermission(ctx.user!.group || 'visitor', 'editor')) {
  return new Response('Forbidden', { status: 403 });
}

const { db, options, urls, user, csrfToken } = ctx;
const cid = Astro.url.searchParams.get('cid');
const rawRequestedParent = Astro.url.searchParams.get('parent') || '';
type ContentRow = typeof schema.contents.$inferSelect;
interface AttachmentItem { cid: number; title: string | null; url: string; size: number; isImage: boolean; }
interface ParentPageOption { cid: number; title: string; depth: number; }
const MIN_EDITOR_HEIGHT = 100;
const MAX_EDITOR_HEIGHT = 2_000;
function normalizeEditorHeight(value: string | number | null | undefined, fallback: number): number {
  const parsed = Number(value);
  return Number.isInteger(parsed) && parsed >= MIN_EDITOR_HEIGHT && parsed <= MAX_EDITOR_HEIGHT
    ? parsed
    : fallback;
}

function buildParentPageOptions(rows: ContentRow[], currentCid: number): ParentPageOption[] {
  const children = new Map<number, ContentRow[]>();
  for (const row of rows) {
    const parent = row.parent || 0;
    const bucket = children.get(parent) || [];
    bucket.push(row);
    children.set(parent, bucket);
  }
  const sortPages = (pages: ContentRow[]) => pages.sort((a, b) => (a.order || 0) - (b.order || 0) || a.cid - b.cid);
  for (const pages of children.values()) sortPages(pages);

  const excluded = new Set<number>();
  const excludeDescendants = (pageCid: number) => {
    if (excluded.has(pageCid)) return;
    excluded.add(pageCid);
    for (const child of children.get(pageCid) || []) excludeDescendants(child.cid);
  };
  if (currentCid > 0) excludeDescendants(currentCid);

  const options: ParentPageOption[] = [];
  const visited = new Set<number>();
  const appendChildren = (parent: number, depth: number) => {
    for (const row of children.get(parent) || []) {
      if (visited.has(row.cid)) continue;
      visited.add(row.cid);
      if (!excluded.has(row.cid)) options.push({ cid: row.cid, title: row.title || '无标题', depth });
      appendChildren(row.cid, depth + 1);
    }
  };
  appendChildren(0, 0);
  for (const row of rows) {
    if (!visited.has(row.cid)) appendChildren(row.parent || 0, 0);
  }
  return options;
}

let page: ContentRow | null = null;
let isEdit = false;
let customFields: { name: string; type: string; value: string }[] = [];
let attachments: AttachmentItem[] = [];
let parentPageRows: ContentRow[] = [];
let editorHeight = normalizeEditorHeight(options.editorSize, 350);
let userWritingOptionRows: Array<{ name: string; value: string | null }> = [];

const cidNum = cid ? parseInt(cid, 10) : 0;
if (cidNum > 0) {
  const [pageRows, fieldRows, attachmentRows, parentRows, editorSizeRows, writingOptionRows] = await db.batch([
    db.select().from(schema.contents).where(eq(schema.contents.cid, cidNum)).limit(1),
    db.select().from(schema.fields).where(eq(schema.fields.cid, cidNum)),
    db.select().from(schema.contents)
      .where(and(eq(schema.contents.type, 'attachment'), eq(schema.contents.parent, cidNum)))
      .orderBy(schema.contents.created),
    db.select().from(schema.contents)
      .where(eq(schema.contents.type, 'page'))
      .orderBy(schema.contents.order, schema.contents.cid),
    db.select({ value: schema.options.value }).from(schema.options)
      .where(and(eq(schema.options.name, 'editorSize'), eq(schema.options.user, user!.uid)))
      .limit(1),
    db.select({ name: schema.options.name, value: schema.options.value }).from(schema.options)
      .where(and(
        eq(schema.options.user, user!.uid),
        inArray(schema.options.name, ['markdown', 'autoSave', 'defaultAllowComment', 'defaultAllowPing', 'defaultAllowFeed']),
      )),
  ]);
  page = pageRows[0] || null;
  parentPageRows = parentRows;
  editorHeight = normalizeEditorHeight(editorSizeRows[0]?.value, editorHeight);
  userWritingOptionRows = writingOptionRows;
  if (page) {
    isEdit = true;
    customFields = fieldRows.map(f => ({
      name: f.name,
      type: f.type || 'str',
      value: f.type === 'int' ? String(f.int_value || 0)
           : f.type === 'float' ? String(f.float_value || 0)
           : (f.str_value || ''),
    }));
    attachments = attachmentRows.map(row => {
      let meta: Record<string, unknown> = {};
      try { meta = JSON.parse(row.text || '{}'); } catch {}
      return {
        cid: row.cid,
        title: row.title,
        url: (meta.url as string) || '',
        size: (meta.size as number) || 0,
        isImage: ((meta.type as string) || '').startsWith('image/'),
      };
    });
  }
} else {
  const [parentRows, editorSizeRows, writingOptionRows] = await db.batch([
    db.select().from(schema.contents)
      .where(eq(schema.contents.type, 'page'))
      .orderBy(schema.contents.order, schema.contents.cid),
    db.select({ value: schema.options.value }).from(schema.options)
      .where(and(eq(schema.options.name, 'editorSize'), eq(schema.options.user, user!.uid)))
      .limit(1),
    db.select({ name: schema.options.name, value: schema.options.value }).from(schema.options)
      .where(and(
        eq(schema.options.user, user!.uid),
        inArray(schema.options.name, ['markdown', 'autoSave', 'defaultAllowComment', 'defaultAllowPing', 'defaultAllowFeed']),
      )),
  ]);
  parentPageRows = parentRows;
  editorHeight = normalizeEditorHeight(editorSizeRows[0]?.value, editorHeight);
  userWritingOptionRows = writingOptionRows;
}

const userWritingOptions = new Map(userWritingOptionRows.map((option) => [option.name, option.value]));
const userPreference = (name: string, fallback: number) => Number(userWritingOptions.get(name) ?? fallback) === 1;
const isMarkdown = page
  ? (page.text || '').indexOf('<!--markdown-->') >= 0
  : userPreference('markdown', Number(options.markdown) || 0);
const autoSave = userPreference('autoSave', Number(options.autoSave) || 0);
const defaultAllowComment = userPreference('defaultAllowComment', Number(options.defaultAllowComment) || 0);
const defaultAllowPing = userPreference('defaultAllowPing', Number(options.defaultAllowPing) || 0);
const defaultAllowFeed = userPreference('defaultAllowFeed', Number(options.defaultAllowFeed) || 0);
const pagePermalinkPattern = options.pagePattern || '/{slug}.html';
const allowsSlugEdit = pagePermalinkPattern.includes('{slug}');
const slugMarker = '__TYPECHO_SLUG__';
const permalinkPath = renderPermalinkPattern(pagePermalinkPattern, 'page', {
  cid: page?.cid || '{cid}',
  slug: slugMarker,
}) || pagePermalinkPattern;
const permalinkDisplay = (() => {
  const siteUrl = urls.siteUrl.replace(/^[a-z][a-z0-9+.-]*:\/\//i, '').replace(/\/+$/, '');
  const path = permalinkPath.startsWith('/') ? permalinkPath : `/${permalinkPath}`;
  return siteUrl ? `${siteUrl}${path}` : path.replace(/^\/+/, '');
})();
const slugMarkerIndex = permalinkDisplay.indexOf(slugMarker);
const slugPrefix = slugMarkerIndex >= 0 ? permalinkDisplay.slice(0, slugMarkerIndex) : permalinkDisplay;
const slugSuffix = slugMarkerIndex >= 0 ? permalinkDisplay.slice(slugMarkerIndex + slugMarker.length) : '';
const scheduleDate = page?.created
  ? formatDate(page.created, 'Y-m-d H:i', Number(options.timezone) || 0)
  : '';
const parentPageOptions = buildParentPageOptions(parentPageRows, page?.cid || 0);
const requestedParentId = !isEdit && /^\d+$/.test(rawRequestedParent)
  ? Number(rawRequestedParent)
  : 0;
const initialParentId = parentPageOptions.some(parent => parent.cid === requestedParentId)
  ? requestedParentId
  : 0;
const selectedParentId = page?.parent ?? initialParentId;
const requestedParent = !isEdit && initialParentId > 0
  ? parentPageRows.find(parent => parent.cid === initialParentId)
  : null;
const pageEditorTitle = isEdit
  ? '编辑页面'
  : requestedParent
    ? `新增 ${requestedParent.title || '无标题'} 的子页面`
    : '创建新页面';
const activeTheme = options.theme || 'typecho-theme-minimal';
const pageTemplateOptions = Object.entries(themeTemplates[activeTheme]?.PageTemplates ?? {});
const hasCurrentPageTemplate = !page?.template || pageTemplateOptions.some(([template]) => template === page?.template);
const writePageOptionHtml = await applyFilterSafely(ctx, 'admin:writePage:option', '', { options, page, user, isEdit });
const writePageAdvanceOptionHtml = await applyFilterSafely(ctx, 'admin:writePage:advanceOption', '', { options, page, user, isEdit });
const writePageBottomHtml = await applyFilterSafely(ctx, 'admin:writePage:bottom', '', { options, page, user, isEdit });

---
<Admin
  title={pageEditorTitle}
  options={options}
  urls={urls}
  user={user}
  activeMenu={isEdit ? 'manage-pages' : 'write-page'}
  bodyClass="typecho-post-area"
  pluginCtx={ctx}
>
  <form action="/api/admin/content" method="post" name="write_page" data-auto-save={autoSave ? '1' : '0'}>
    <input type="hidden" name="_" value={csrfToken} />
    <div class="col-mb-12 col-tb-9" role="main">
      {isEdit && page.type === 'page_draft' && (
        <cite class="edit-draft-notice">当前正在编辑的是未发布的草稿</cite>
      )}

      <p class="title">
        <label for="title" class="sr-only">标题</label>
        <input type="text" id="title" name="title" autocomplete="off"
          value={page?.title || ''} placeholder="标题" class="w-100 text title" />
      </p>

      <p class="mono url-slug">
        {allowsSlugEdit ? (
          <>
            <label for="slug" class="sr-only">网址缩略名</label>
            <span>{slugPrefix}</span>
            <input type="text" id="slug" name="slug" autocomplete="off"
              value={page?.slug || ''} class="mono" placeholder={isEdit ? String(page?.cid) : ''} />
            <span>{slugSuffix}</span>
          </>
        ) : <span>{permalinkDisplay}</span>}
      </p>

      <p>
        <label for="text" class="sr-only">页面内容</label>
        <textarea style={`height: ${editorHeight}px`} autocomplete="off"
          id="text" name="text" class="w-100 mono">{page?.text ? page.text.replace(/^<!--markdown-->/, '') : ''}</textarea>
      </p>

      <details id="custom-field" class="typecho-post-option" open={customFields.length > 0}>
        <summary>自定义字段</summary>
        <ul class="fields mono">
          {customFields.map((f) => (
            <li class="field">
              <div class="field-name">
                <label for={`fieldname-${f.name}`} class="sr-only">字段名称</label>
                <input type="text" id={`fieldname-${f.name}`} name="fieldNames[]" value={f.name}
                  pattern="^[_a-zA-Z][_a-zA-Z0-9]*$" class="text-s w-100" />
                <label for={`fieldtype-${f.name}`} class="sr-only">字段类型</label>
                <select id={`fieldtype-${f.name}`} name={`fieldTypes[${f.name}]`} class="field-type-select">
                  <option value="str" selected={f.type === 'str'}>字符</option>
                  <option value="int" selected={f.type === 'int'}>整数</option>
                  <option value="float" selected={f.type === 'float'}>小数</option>
                </select>
              </div>
              <div class="field-value">
                <label for={`fieldvalue-${f.name}`} class="sr-only">字段值</label>
                <textarea id={`fieldvalue-${f.name}`} name={`fieldValues[${f.name}]`} class="text-s w-100 mono" rows="2">{f.value}</textarea>
                <button type="button" class="btn btn-xs remove-field">删除</button>
              </div>
            </li>
          ))}
          {customFields.length === 0 && (
            <li class="field">
              <div class="field-name">
                <label for="fieldname-new" class="sr-only">字段名称</label>
                <input type="text" id="fieldname-new" name="fieldNames[]" value=""
                  placeholder="字段名称" pattern="^[_a-zA-Z][_a-zA-Z0-9]*$" class="text-s w-100" />
                <label for="fieldtype-new" class="sr-only">字段类型</label>
                <select id="fieldtype-new" name="fieldTypes[newfield_0]" class="field-type-select">
                  <option value="str">字符</option>
                  <option value="int">整数</option>
                  <option value="float">小数</option>
                </select>
              </div>
              <div class="field-value">
                <label for="fieldvalue-new" class="sr-only">字段值</label>
                <textarea id="fieldvalue-new" name="fieldValues[newfield_0]" class="text-s w-100 mono" rows="2" placeholder="字段值"></textarea>
                <button type="button" class="btn btn-xs remove-field">删除</button>
              </div>
            </li>
          )}
        </ul>
        <div class="add">
          <button type="button" id="add-field-btn" class="btn btn-xs">+添加字段</button>
          <div class="description kit-hidden-mb">
            自定义字段可以扩展你的模板功能, 使用方法参见 <a href="https://docs.typecho.org/help/custom-fields">帮助文档</a>
          </div>
        </div>
      </details>

      {writePageBottomHtml && <Fragment set:html={writePageBottomHtml} />}

      <p class="submit clearfix">
        <span class="left">
          <button type="button" id="btn-cancel-preview" class="btn"><i class="i-caret-left"></i> 取消预览</button>
        </span>
        <span class="right">
          <input type="hidden" name="do" value={isEdit ? 'update' : 'create'} />
          <input type="hidden" name="type" value="page" />
          {isEdit && <input type="hidden" name="cid" value={String(page.cid)} />}
          <button type="button" id="btn-preview" class="btn"><i class="i-exlink"></i> 预览页面</button>
          <button type="submit" name="status" value="draft" id="btn-save" class="btn">保存草稿</button>
          <button type="submit" name="status" value="publish" class="btn primary" id="btn-submit">发布页面</button>
          {isMarkdown && <input type="hidden" name="markdown" value="1" />}
        </span>
      </p>
    </div>

    <div id="edit-secondary" class="col-mb-12 col-tb-3" role="complementary">
      <ul class="typecho-option-tabs clearfix">
        <li class="active w-50"><a href="#tab-advance">选项</a></li>
        <li class="w-50"><a href="#tab-files" id="tab-files-btn">附件</a></li>
      </ul>

      <div id="tab-advance" class="tab-content">
        <section class="typecho-post-option" role="application">
          <label for="date" class="typecho-label">发布日期</label>
          <p>
            <input class="typecho-date w-100" type="text" name="date" id="date" autocomplete="off"
              data-timezone={String((Number(options.timezone) || 0) / 60)} value={scheduleDate} />
          </p>
        </section>

        <section class="typecho-post-option">
          <label for="order" class="typecho-label">页面顺序</label>
          <p><input type="number" id="order" name="order" value={String(page?.order || 0)} class="w-100" /></p>
          <p class="description">为你的自定义页面设定一个序列值以后, 能够使得它们按此值从小到大排列</p>
        </section>

        <section class="typecho-post-option">
          <label for="template" class="typecho-label">自定义模板</label>
          <p>
            <select name="template" id="template">
              <option value="" selected={!page?.template}>不选择</option>
              {pageTemplateOptions.map(([template, definition]) => (
                <option value={template} selected={page?.template === template}>{definition.name}</option>
              ))}
              {page?.template && !hasCurrentPageTemplate && (
                <option value={page.template} selected>当前模板不可用: {page.template}</option>
              )}
            </select>
          </p>
          <p class="description">如果你为此页面选择了一个自定义模板, 系统将按照你选择的模板文件展现它</p>
        </section>

        <section class="typecho-post-option">
          <label for="parent" class="typecho-label">父级页面</label>
          <p>
            <select name="parent" id="parent">
              <option value="0" selected={selectedParentId === 0}>不选择</option>
              {parentPageOptions.map((parent) => (
                <option value={String(parent.cid)} selected={selectedParentId === parent.cid}>
                  {'\u00a0\u00a0\u00a0\u00a0'.repeat(parent.depth)}{parent.title}
                </option>
              ))}
            </select>
          </p>
          <p class="description">如果你设定了父级页面, 此页面将作为子页面呈现</p>
        </section>

        {writePageOptionHtml && <Fragment set:html={writePageOptionHtml} />}

        <details id="advance-panel">
          <summary class="btn btn-xs">高级选项 <i class="i-caret-down"></i></summary>
          <section class="typecho-post-option visibility-option">
            <label for="visibility" class="typecho-label">公开度</label>
            <p>
              <select id="visibility" name="visibility">
                <option value="publish" selected={(!page?.status || page?.status === 'publish')}>公开</option>
                <option value="hidden" selected={page?.status === 'hidden'}>隐藏</option>
              </select>
            </p>
          </section>

          <section class="typecho-post-option allow-option">
            <label class="typecho-label">权限控制</label>
            <ul>
              <li>
                <input id="allowComment" name="allowComment" type="checkbox" value="1"
                  checked={page ? page.allowComment === '1' : defaultAllowComment} />
                <label for="allowComment">允许评论</label>
              </li>
              <li>
                <input id="allowPing" name="allowPing" type="checkbox" value="1"
                  checked={page ? page.allowPing === '1' : defaultAllowPing} />
                <label for="allowPing">允许被引用</label>
              </li>
              <li>
                <input id="allowFeed" name="allowFeed" type="checkbox" value="1"
                  checked={page ? page.allowFeed === '1' : defaultAllowFeed} />
                <label for="allowFeed">允许在聚合中出现</label>
              </li>
            </ul>
          </section>
          {writePageAdvanceOptionHtml && <Fragment set:html={writePageAdvanceOptionHtml} />}
        </details>
      </div>

      <div id="tab-files" class="tab-content hidden">
        <div id="upload-panel" class="p" data-cid={isEdit ? String(page.cid) : '0'}>
          <div class="upload-area" draggable="true">
            <p>拖放文件到这里<br />或 <a href="#" class="upload-file">选择文件上传</a></p>
            <input type="file" id="file-input" multiple style="display:none" />
          </div>
          <ul id="file-list">
            {attachments.map(att => (
              <li data-cid={String(att.cid)} data-url={att.url} data-image={att.isImage ? '1' : '0'}>
                <input type="hidden" name="attachment[]" value={String(att.cid)} />
                <a class="insert" title="点击插入文件" href="#">{att.title}</a>
                <div class="info">
                  {att.size < 1024 ? att.size + ' B' : att.size < 1024*1024 ? Math.ceil(att.size/1024) + ' KB' : (att.size/(1024*1024)).toFixed(1) + ' MB'}
                  {' '}<a class="delete" href="#" title="删除"><i class="i-delete"></i></a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </form>

  <Fragment slot="footer">
    <script is:inline src="/vendor/hyperdown.js"></script>
    <script is:inline src="/vendor/pagedown.js"></script>
    <script is:inline src="/vendor/paste.js"></script>
    <script is:inline src="/vendor/purify.js"></script>
    <script is:inline src="/vendor/timepicker.js"></script>
    <script is:inline src="/vendor/typecho-tags.js"></script>
    <script is:inline>
    $(document).ready(function () {
      var dateInput = $('#date');
      dateInput.mask('9999-99-99 99:99').datetimepicker({
        currentText: '现在',
        prevText: '上一月',
        nextText: '下一月',
        monthNames: ['一月', '二月', '三月', '四月', '五月', '六月', '七月', '八月', '九月', '十月', '十一月', '十二月'],
        dayNames: ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六'],
        dayNamesShort: ['周日', '周一', '周二', '周三', '周四', '周五', '周六'],
        dayNamesMin: ['日', '一', '二', '三', '四', '五', '六'],
        closeText: '完成',
        timeOnlyTitle: '选择时间',
        timeText: '时间',
        hourText: '时',
        minuteText: '分',
        secondText: '秒',
        dateFormat: 'yy-mm-dd',
        timezone: Number(dateInput.data('timezone')),
        hour: (new Date()).getHours(),
        minute: (new Date()).getMinutes()
      });

      var textarea = $('#text'),
          isFullScreen = false,
          toolbar = $('<div class="editor" id="wmd-button-bar" />').insertBefore(textarea.parent()),
          preview = $('<div id="wmd-preview" class="wmd-hidetab" />').insertAfter('.editor');

      var options = {};

      options.strings = {
        bold: '加粗 <strong> Ctrl+B',
        boldexample: '加粗文字',
        italic: '斜体 <em> Ctrl+I',
        italicexample: '斜体文字',
        link: '链接 <a> Ctrl+L',
        linkdescription: '请输入链接描述',
        quote: '引用 <blockquote> Ctrl+Q',
        quoteexample: '引用文字',
        code: '代码 <pre><code> Ctrl+K',
        codeexample: '请输入代码',
        image: '图片 <img> Ctrl+G',
        imagedescription: '请输入图片描述',
        olist: '数字列表 <ol> Ctrl+O',
        ulist: '普通列表 <ul> Ctrl+U',
        litem: '列表项目',
        heading: '标题 <h1>/<h2> Ctrl+H',
        headingexample: '标题文字',
        hr: '分割线 <hr> Ctrl+R',
        more: '摘要分割线 <!--more--> Ctrl+M',
        undo: '撤销 - Ctrl+Z',
        redo: '重做 - Ctrl+Y',
        redomac: '重做 - Ctrl+Shift+Z',
        fullscreen: '全屏 - Ctrl+J',
        exitFullscreen: '退出全屏 - Ctrl+E',
        fullscreenUnsupport: '此浏览器不支持全屏操作',
        imagedialog: '<p><b>插入图片</b></p><p>请在下方的输入框内输入要插入的远程图片地址</p>',
        linkdialog: '<p><b>插入链接</b></p><p>请在下方的输入框内输入要插入的链接地址</p>',
        ok: '确定',
        cancel: '取消',
        help: 'Markdown语法帮助'
      };

      var converter = new HyperDown(),
          editor = new Markdown.Editor(converter, '', options);

      converter.enableHtml(true);
      converter.enableLine(true);
      reloadScroll = scrollableEditor(textarea, preview);

      converter.hook('makeHtml', function (html) {
        html = html.replace('<p><!--more--></p>', '<!--more-->');
        if (html.indexOf('<!--more-->') > 0) {
          var parts = html.split(/\s*<\!\-\-more\-\->\s*/),
              summary = parts.shift(),
              details = parts.join('');
          html = '<div class="summary">' + summary + '</div>'
              + '<div class="details">' + details + '</div>';
        }
        html = html.replace(/<(iframe|embed)\s+([^>]*)>/ig, function (all, tag, src) {
          if (src[src.length - 1] == '/') { src = src.substring(0, src.length - 1); }
          return '<div class="embed"><strong>' + tag + '</strong> : ' + $.trim(src) + '</div>';
        });
        return DOMPurify.sanitize(html, {USE_PROFILES: {html: true}});
      });

      editor.hooks.chain('onPreviewRefresh', function () {
        var images = $('img', preview), count = images.length;
        if (count == 0) { reloadScroll(true); }
        else {
          images.bind('load error', function () {
            count--;
            if (count == 0) { reloadScroll(true); }
          });
        }
      });

      var th = textarea.height(), ph = preview.height();

      editor.hooks.chain('enterFakeFullScreen', function () {
        th = textarea.height(); ph = preview.height();
        $(document.body).addClass('fullscreen');
        var h = $(window).height() - toolbar.outerHeight();
        textarea.css('height', h); preview.css('height', h);
        isFullScreen = true;
      });

      editor.hooks.chain('enterFullScreen', function () {
        $(document.body).addClass('fullscreen');
        var h = window.screen.height - toolbar.outerHeight();
        textarea.css('height', h); preview.css('height', h);
        isFullScreen = true;
      });

      editor.hooks.chain('exitFullScreen', function () {
        $(document.body).removeClass('fullscreen');
        textarea.height(th); preview.height(ph);
        isFullScreen = false;
      });

      editor.hooks.chain('commandExecuted', function () {
        textarea.trigger('input');
      });

      editor.run();

      // Personal auto-save preference matches the Typecho 1.3 editor flow.
      (function () {
        var form = $('form[name="write_page"]'),
            autoSaveEnabled = form.attr('data-auto-save') === '1',
            autoSaveMessage = $('<span id="auto-save-message"></span>').prependTo('.submit .left'),
            changed = false,
            saving = false,
            saveTimer = null,
            lastSaveTime = '',
            previewRequested = false,
            previewWasFullscreen = false;

        function message(text) {
          autoSaveMessage.text(text);
        }

        function markChanged() {
          changed = true;
          if (!autoSaveEnabled || saving) return;
          message('尚未保存' + (lastSaveTime ? ' (上次保存时间: ' + lastSaveTime + ')' : ''));
          if (saveTimer) clearTimeout(saveTimer);
          saveTimer = setTimeout(saveDraft, 3000);
        }

        function previewData(cid) {
          if (!cid) return;
          previewWasFullscreen = $(document.body).hasClass('fullscreen');
          $(document.body).addClass('fullscreen preview');

          $('.preview-frame').remove();
          var frame = $('<iframe frameborder="0" class="preview-frame preview-loading"></iframe>')
            .attr('src', '/admin/preview?cid=' + encodeURIComponent(cid))
            .attr('sandbox', 'allow-same-origin allow-scripts')
            .appendTo(document.body);

          frame.on('load', function () {
            frame.removeClass('preview-loading');
          });
          frame.height($(window).height() - 53);
        }

        function previewSavedData() {
          var draftId = Number(form.find('input[name="autosaveDraftId"]').val() || 0),
              cid = Number(form.find('input[name="cid"]').val() || 0);
          previewData(draftId || cid);
        }

        function cancelPreview() {
          if (!previewWasFullscreen) {
            $(document.body).removeClass('fullscreen');
          }
          $(document.body).removeClass('preview');
          $('.preview-frame').remove();
        }

        function saveDraft() {
          if (!changed || saving) return;
          changed = false;
          saving = true;
          message('正在保存');
          var data = new FormData(form.get(0));
          data.set('autosave', '1');
          data.set('status', 'draft');
          $.ajax({
            url: form.attr('action'),
            type: 'POST',
            data: data,
            processData: false,
            contentType: false,
            success: function (result) {
              var savedCid = Number(result && result.cid);
              if (savedCid > 0) {
                var cidInput = form.find('input[name="cid"]');
                if (!cidInput.length) {
                  cidInput = $('<input type="hidden" name="cid" />').appendTo(form);
                }
                cidInput.val(savedCid);
                form.find('input[name="do"]').val('update');
                $('#upload-panel').attr('data-cid', savedCid).data('cid', savedCid);
              }
              var draftId = Number(result && result.draftId);
              if (draftId > 0) {
                var draftInput = form.find('input[name="autosaveDraftId"]');
                if (!draftInput.length) {
                  draftInput = $('<input type="hidden" name="autosaveDraftId" />').appendTo(form);
                }
                draftInput.val(draftId);
              }
              lastSaveTime = new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit', hour12: false });
              message(changed ? '尚未保存 (上次保存时间: ' + lastSaveTime + ')' : '已保存 (' + lastSaveTime + ')');
            },
            error: function () {
              changed = true;
              previewRequested = false;
              message('保存失败, 请重试');
            },
            complete: function () {
              saving = false;
              if (changed && previewRequested) {
                saveDraft();
              } else if (changed && autoSaveEnabled) {
                if (saveTimer) clearTimeout(saveTimer);
                saveTimer = setTimeout(saveDraft, 3000);
              } else if (previewRequested) {
                previewRequested = false;
                previewSavedData();
              }
            }
          });
        }

        form.on('input change', 'input, textarea, select', markChanged);
        form.on('submit', function () {
          if (saveTimer) clearTimeout(saveTimer);
          autoSaveEnabled = false;
        });
        $(window).on('beforeunload.writePage', function () {
          if (changed) return '内容已经改变尚未保存, 您确认要离开此页面吗?';
        });

        $('#btn-preview').on('click', function () {
          if (!changed) {
            previewSavedData();
            return;
          }
          if (window.confirm('修改后的内容需要保存后才能预览, 是否保存?')) {
            previewRequested = true;
            saveDraft();
          }
        });
        $('#btn-cancel-preview').on('click', cancelPreview);
        $(window).on('message.writePagePreview', function (event) {
          var messageEvent = event.originalEvent;
          if (messageEvent && messageEvent.origin === window.location.origin && messageEvent.data === 'cancelPreview') {
            cancelPreview();
          }
        });
      })();

      // Keep the Typecho resize handle while storing the preferred height on
      // the current user instead of changing the site-wide editor default.
      (function () {
        var resizeHandle = $('<span class="resize" role="separator" aria-label="调整编辑器高度" aria-orientation="horizontal" tabindex="0"><i></i></span>').insertAfter(textarea),
            minHeight = 100,
            maxHeight = 2000;

        function applyHeight(height) {
          var nextHeight = Math.max(minHeight, Math.min(maxHeight, Math.round(height)));
          textarea.height(nextHeight);
          preview.outerHeight(nextHeight);
          textarea.trigger('resize');
          return nextHeight;
        }

        function persistHeight(height) {
          $.ajax({
            url: '/api/admin/editor-size',
            type: 'POST',
            data: { size: height },
            headers: { 'X-CSRF-Token': String($('form[name="write_page"] input[name="_"]').val() || '') },
          });
        }

        resizeHandle.on('mousedown', function (event) {
          event.preventDefault();
          textarea.blur().css('opacity', 0.25);
          var startY = event.pageY,
              startHeight = textarea.outerHeight();
          $(document).on('mousemove.editorResize', function (moveEvent) {
            applyHeight(startHeight + moveEvent.pageY - startY);
          }).on('mouseup.editorResize', function () {
            $(document).off('.editorResize');
            persistHeight(Math.round(textarea.outerHeight()));
            textarea.css('opacity', 1);
            textarea.focus();
          });
        }).on('keydown', function (event) {
          if (event.key !== 'ArrowUp' && event.key !== 'ArrowDown') return;
          event.preventDefault();
          persistHeight(applyHeight(textarea.outerHeight() + (event.key === 'ArrowUp' ? -20 : 20)));
        });
      })();

      // 编辑预览切换
      var edittab = $('.editor').prepend('<div class="wmd-edittab"><a href="#wmd-editarea" class="active">撰写</a><a href="#wmd-preview">预览</a></div>'),
          editarea = $(textarea.parent()).attr("id", "wmd-editarea");

      $(".wmd-edittab a").click(function() {
        $(".wmd-edittab a").removeClass('active');
        $(this).addClass("active");
        $("#wmd-editarea, #wmd-preview").addClass("wmd-hidetab");
        var selected_tab = $(this).attr("href"),
            selected_el = $(selected_tab).removeClass("wmd-hidetab");
        if (selected_tab == "#wmd-preview") {
          $("#wmd-button-row").addClass("wmd-visualhide");
        } else {
          $("#wmd-button-row").removeClass("wmd-visualhide");
        }
        $("#wmd-preview").outerHeight($("#wmd-editarea").innerHeight());
        return false;
      });

      // 缩略名仅在永久链接格式使用 {slug} 时存在，并随内容长度调整宽度。
      $('#slug').on('input', function () {
        $(this).attr('size', Math.max(5, String($(this).val() || '').length));
      }).each(function () {
        $(this).attr('size', Math.max(5, String($(this).val() || '').length));
      });

      // ========== 自定义字段 ==========
      (function () {
        var fieldIdx = $('#custom-field .field').length;
        var customField = $('#custom-field');

        $('#add-field-btn').click(function () {
          fieldIdx++;
          var name = 'newfield_' + fieldIdx;
          var field = '<li class="field">'
            + '<div class="field-name"><input type="text" name="fieldNames[]" value="" pattern="^[_a-zA-Z][_a-zA-Z0-9]*$" class="text-s w-100" placeholder="字段名称" />'
            + '<select name="fieldTypes[' + name + ']" class="field-type-select"><option value="str">字符</option><option value="int">整数</option><option value="float">小数</option></select></div>'
            + '<div class="field-value"><textarea name="fieldValues[' + name + ']" class="text-s w-100 mono" rows="2" placeholder="字段值"></textarea>'
            + '<button type="button" class="btn btn-xs remove-field">删除</button></div>'
            + '</li>';
          customField.find('.fields').append(field);
          customField.prop('open', true);
        });

        $(document).on('click', '.remove-field', function () {
          $(this).closest('.field').remove();
        });

        // Keep the project fieldTypes[name]/fieldValues[name] API contract.
        $(document).on('input', '#custom-field input[name="fieldNames[]"]', function () {
          var newName = $.trim(String($(this).val() || ''));
          if (!newName) return;
          var field = $(this).closest('.field');
          field.find('.field-type-select').attr('name', 'fieldTypes[' + newName + ']');
          field.find('textarea').attr('name', 'fieldValues[' + newName + ']');
        });
      })();

      // 选项/附件 Tab 切换
      $('.typecho-option-tabs a').click(function () {
        var target = $(this).attr('href');
        $('.typecho-option-tabs li').removeClass('active');
        $(this).parent().addClass('active');
        $('.tab-content').addClass('hidden');
        $(target).removeClass('hidden');
        return false;
      });

      // ========== 文件上传 ==========
      (function () {
        var uploadPanel = $('#upload-panel'),
            cid = uploadPanel.data('cid') || 0,
            fileInput = $('#file-input'),
            fileList = $('#file-list');

        function updateAttachmentNumber() {
          var btn = $('#tab-files-btn'),
              balloon = $('.balloon', btn),
              count = $('#file-list li .insert').length;
          if (count > 0) {
            if (!balloon.length) {
              btn.html($.trim(btn.html()) + ' ');
              balloon = $('<span class="balloon"></span>').appendTo(btn);
            }
            balloon.html(count);
          } else if (balloon.length) {
            balloon.remove();
          }
        }

        function fileUploadStart(name, id) {
          $('<li id="upload-' + id + '" class="loading">' + name + '</li>').appendTo(fileList);
        }

        function fileUploadComplete(id, data) {
          var li = $('#upload-' + id).removeClass('loading')
            .data('cid', data.cid).data('url', data.url).data('image', data.isImage)
            .html('<input type="hidden" name="attachment[]" value="' + data.cid + '" />'
              + '<a class="insert" target="_blank" href="#" title="点击插入文件">' + data.title + '</a>'
              + '<div class="info">' + data.bytes
              + ' <a class="delete" href="#" title="删除"><i class="i-delete"></i></a></div>');
          attachInsertEvent(li);
          attachDeleteEvent(li);
          updateAttachmentNumber();
        }

        function fileUploadError(id, msg) {
          var exist = $('#upload-' + id);
          if (exist.length) {
            exist.removeClass('loading').html(msg).css('color', '#B94A48');
            setTimeout(function () { exist.fadeOut(function () { $(this).remove(); }); }, 3000);
          }
        }

        function doUpload(files) {
          for (var i = 0; i < files.length; i++) {
            (function (file, idx) {
              var uid = Date.now().toString(36) + idx;
              fileUploadStart(file.name, uid);

              var fd = new FormData();
              fd.append('file', file);
              fd.append('cid', String(cid));

              $.ajax({
                url: '/api/admin/upload',
                type: 'POST',
                data: fd,
                processData: false,
                contentType: false,
                dataType: 'json',
                headers: { 'X-CSRF-Token': String($('form[name="write_page"] input[name="_"]').val() || '') },
                success: function (resp) {
                  if ($.isArray(resp) && resp[1]) {
                    fileUploadComplete(uid, resp[1]);
                    if (!cid && resp[1].cid) cid = resp[1].cid;
                  } else if (resp && resp.error) {
                    fileUploadError(uid, file.name + ' 上传失败: ' + resp.error);
                  }
                },
                error: function () {
                  fileUploadError(uid, file.name + ' 上传失败');
                }
              });
            })(files[i], i);
          }
        }

        $('.upload-file').click(function (e) {
          e.preventDefault();
          fileInput.click();
        });
        fileInput.change(function () {
          if (this.files && this.files.length) {
            doUpload(this.files);
            this.value = '';
          }
        });

        var uploadArea = $('.upload-area');
        uploadArea.on('dragenter dragover', function (e) {
          e.preventDefault(); e.stopPropagation();
          $(this).parent().addClass('drag');
        }).on('dragleave dragend', function (e) {
          e.preventDefault(); e.stopPropagation();
          $(this).parent().removeClass('drag');
        }).on('drop', function (e) {
          e.preventDefault(); e.stopPropagation();
          $(this).parent().removeClass('drag');
          var files = e.originalEvent.dataTransfer.files;
          if (files && files.length) doUpload(files);
        });

        function attachInsertEvent(el) {
          $('.insert', el).click(function (e) {
            e.preventDefault();
            var t = $(this), p = t.parents('li'),
                url = p.data('url'), isImage = p.data('image'),
                title = t.text();
            Typecho.insertFileToEditor(title, url, isImage);
          });
        }

        function attachDeleteEvent(el) {
          var name = $('a.insert', el).text();
          $('.delete', el).click(function (e) {
            e.preventDefault();
            if (!confirm('确认要删除文件 ' + name + ' 吗?')) return;
            var attachCid = $(el).data('cid');
            $.ajax({
              url: '/api/admin/upload?cid=' + attachCid,
              type: 'DELETE',
              dataType: 'json',
              headers: { 'X-CSRF-Token': String($('form[name="write_page"] input[name="_"]').val() || '') },
              success: function () {
                $(el).fadeOut(function () {
                  $(this).remove();
                  updateAttachmentNumber();
                });
              }
            });
          });
        }

        $('#file-list li').each(function () {
          attachInsertEvent(this);
          attachDeleteEvent(this);
        });

        updateAttachmentNumber();

        // Convert absolute URL to relative path for portability
        Typecho.insertFileToEditor = function (title, url, isImage) {
          var textarea = $('#text'), sel = textarea.getSelection();
          var relUrl = url;
          try {
            var u = new URL(url, location.origin);
            relUrl = u.pathname;
          } catch (e) {}
          var md;
          if (isImage == 1 || isImage === true) {
            md = '![' + title + '](' + relUrl + ')';
          } else {
            md = '[' + title + '](' + relUrl + ')';
          }
          textarea.replaceSelection(md);
          textarea.setSelection(sel.start + md.length, sel.start + md.length);
          textarea.trigger('input');
        };

        if ($.fn.pastableTextarea) {
          $('#text').pastableTextarea().on('pasteImage', function (e, data) {
            if (data.blob) {
              var file = new File([data.blob], data.name || ('paste-' + Date.now() + '.png'), { type: 'image/png' });
              doUpload([file]);
            }
          });
        }
      })();
    });
    </script>
  </Fragment>
</Admin>
