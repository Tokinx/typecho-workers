---
import { themeTemplates } from 'virtual:theme-templates';
import { createContextAlongside } from '@/lib/context';
import { prepareNotFoundData, preparePageData, preparePostData } from '@/lib/page-data';
import { buildPermalink, getRedirectPathIfDifferent } from '@/lib/content';
import { getCookieValue } from '@/lib/auth';
import { eq } from 'drizzle-orm';
import { schema } from '@/db';

const { cid } = Astro.params;
const cidNum = parseInt(cid || '0', 10);
if (!cidNum) return Astro.redirect('/');

// Authentication and the content lookup are independent D1 reads. Start both
// immediately so logged-in page views do not pay two inter-region round trips.
const [ctx, contentRow] = await createContextAlongside(
  Astro.locals,
  Astro.request,
  db => db.query.contents.findFirst({ where: eq(schema.contents.cid, cidNum) }),
);

// If it's a page, the data layer will handle the redirect via contentRow.type check
// But we still need to handle the page redirect at the route level
const { options } = ctx;

const suppliedPassword = Astro.url.searchParams.get('password');
const unapprovedCommentToken = getCookieValue(
  Astro.request.headers.get('cookie'),
  '__typecho_unapproved_comment',
);
let result;
let Component;
const activeTheme = options.theme || 'typecho-theme-minimal';
const templates = themeTemplates[activeTheme] ?? {};
const defaultTemplates = themeTemplates['typecho-theme-minimal']!;

// If it's a page, redirect to its configured page route unless that route is this URL.
if (!contentRow) {
  Astro.response.status = 404;
  result = await prepareNotFoundData(ctx, Astro.request.url);
  Component = templates.NotFound ?? defaultTemplates.NotFound!;
} else if (contentRow.type === 'page') {
  const pageUrl = buildPermalink(
    { cid: contentRow.cid, slug: contentRow.slug, type: contentRow.type, created: contentRow.created },
    ctx.urls.siteUrl,
    undefined,
    options.pagePattern as string | undefined,
  );
  const redirectPath = getRedirectPathIfDifferent(Astro.request.url, pageUrl);
  if (redirectPath) return Astro.redirect(redirectPath);

  result = await preparePageData(ctx, contentRow.slug || String(contentRow.cid), Astro.request.url, suppliedPassword, contentRow, unapprovedCommentToken);
  if (result instanceof Response) {
    if (result.status !== 404) return result;
    Astro.response.status = 404;
    result = await prepareNotFoundData(ctx, Astro.request.url);
    Component = templates.NotFound ?? defaultTemplates.NotFound!;
  } else {
    Component = templates.Page ?? defaultTemplates.Page!;
  }
} else {
  result = await preparePostData(ctx, cidNum, Astro.request.url, suppliedPassword, contentRow, unapprovedCommentToken);
  if (result instanceof Response) {
    if (result.status !== 404) return result;
    Astro.response.status = 404;
    result = await prepareNotFoundData(ctx, Astro.request.url);
    Component = templates.NotFound ?? defaultTemplates.NotFound!;
  } else {
    Component = templates.Post ?? defaultTemplates.Post!;
  }
}
---
<Component {...result} />
