---
import { themeTemplates } from 'virtual:theme-templates';
import { createContextAlongside } from '@/lib/context';
import { prepareAuthorData, prepareNotFoundData } from '@/lib/page-data';
import { eq } from 'drizzle-orm';
import { schema } from '@/db';

const { uid } = Astro.params;
const uidNum = parseInt(uid || '0', 10);
if (!uidNum) return Astro.redirect('/');

const [ctx, author] = await createContextAlongside(
  Astro.locals,
  Astro.request,
  db => db.query.users.findFirst({ where: eq(schema.users.uid, uidNum) }),
);
const { options } = ctx;

const activeTheme = options.theme || 'typecho-theme-warm';
const templates = themeTemplates[activeTheme] ?? {};
const defaultTemplates = themeTemplates['typecho-theme-warm']!;
let Component = templates.Archive ?? defaultTemplates.Archive!;

let result = await prepareAuthorData(ctx, uidNum, Astro.request.url, Astro.locals, Astro.url, author);
if (result instanceof Response) {
  if (result.status !== 404) return result;
  Astro.response.status = 404;
  result = await prepareNotFoundData(ctx, Astro.request.url);
  Component = templates.NotFound ?? defaultTemplates.NotFound!;
}
---
<Component {...result} />
