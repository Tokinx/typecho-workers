---
import type { WarmContinuousLoadMode } from './warm';

interface Props {
  hasPrev: boolean;
  hasNext: boolean;
  prevUrl: string | null;
  nextUrl: string | null;
  mode: WarmContinuousLoadMode;
  label: string;
}

const { hasPrev, hasNext, prevUrl, nextUrl, mode, label } = Astro.props;
---
{(hasPrev || hasNext) && (
  <nav
    class="warm-pagination warm-pagination--progressive"
    aria-label={label}
    data-warm-stream-pagination
    data-warm-load-mode={mode}
    data-warm-next-url={hasNext ? nextUrl || undefined : undefined}
  >
    {hasPrev && prevUrl && <a href={prevUrl} rel="prev" aria-label="上一页">←</a>}
    {hasNext && nextUrl && (
      <a href={nextUrl} rel="next" data-warm-load-more data-no-instant>
        加载更多 <span aria-hidden="true">→</span>
      </a>
    )}
    <span class="warm-pagination__status" data-warm-load-status role="status" aria-live="polite"></span>
    {hasNext && <span class="warm-pagination__sentinel" data-warm-load-sentinel aria-hidden="true"></span>}
  </nav>
)}

<script is:inline>
  (() => {
    const autoLimit = mode => mode === 'auto-3' ? 3 : mode === 'infinite' ? Infinity : 0;

    const initialise = pagination => {
      if (pagination.dataset.warmBound === 'true') return;
      pagination.dataset.warmBound = 'true';

      const stream = pagination.parentElement?.querySelector('[data-warm-stream]');
      const link = pagination.querySelector('[data-warm-load-more]');
      const sentinel = pagination.querySelector('[data-warm-load-sentinel]');
      const status = pagination.querySelector('[data-warm-load-status]');
      const limit = autoLimit(pagination.dataset.warmLoadMode || 'manual');
      let automaticLoads = 0;
      let loading = false;
      let observer = null;

      if (!stream || !link) return;

      const setStatus = message => {
        if (status) status.textContent = message;
      };

      const canAutomaticallyLoad = () => (
        !!pagination.dataset.warmNextUrl && automaticLoads < limit
      );

      const syncControls = () => {
        const hasNext = !!pagination.dataset.warmNextUrl;
        link.hidden = hasNext && canAutomaticallyLoad();
        if (!hasNext) {
          link.remove();
          sentinel?.remove();
          observer?.disconnect();
        }
      };

      const loadNext = async automatic => {
        const nextUrl = pagination.dataset.warmNextUrl;
        if (!nextUrl || loading || (automatic && !canAutomaticallyLoad())) return;
        loading = true;
        link.setAttribute('aria-busy', 'true');
        link.setAttribute('aria-disabled', 'true');
        setStatus('正在加载...');
        try {
          const response = await fetch(nextUrl, {
            credentials: 'same-origin',
            headers: { Accept: 'text/html' },
          });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const html = await response.text();
          const document = new DOMParser().parseFromString(html, 'text/html');
          const nextStream = document.querySelector('[data-warm-stream]');
          const nextPagination = document.querySelector('[data-warm-stream-pagination]');
          const items = nextStream
            ? Array.from(nextStream.children).filter(item => item.classList.contains('warm-stream-item'))
            : [];
          if (!items.length) throw new Error('下一页没有可加载的内容');

          stream.append(...items);
          pagination.dataset.warmNextUrl = nextPagination?.getAttribute('data-warm-next-url') || '';
          if (pagination.dataset.warmNextUrl) link.href = pagination.dataset.warmNextUrl;
          if (automatic) automaticLoads += 1;
          setStatus(pagination.dataset.warmNextUrl ? '' : '已加载全部内容');
        } catch (error) {
          setStatus('加载失败，请重试。');
          console.error('[warm] failed to load the next stream page:', error);
        } finally {
          loading = false;
          link.removeAttribute('aria-busy');
          link.removeAttribute('aria-disabled');
          syncControls();
        }
      };

      link.addEventListener('click', event => {
        event.preventDefault();
        loadNext(false);
      });

      if (limit > 0 && sentinel && 'IntersectionObserver' in window) {
        observer = new IntersectionObserver(entries => {
          if (entries.some(entry => entry.isIntersecting)) loadNext(true);
        }, { rootMargin: '160px 0px' });
        observer.observe(sentinel);
      }
      syncControls();
    };

    document.querySelectorAll('[data-warm-stream-pagination]').forEach(initialise);
  })();
</script>
