---
import { env } from 'cloudflare:workers';
import { getDb, schema } from 'typecho/db';
import { getNotesStreamForTheme, type NoteListItem } from 'typecho-plugin-notes';
import { createContext } from '@/lib/context';
import { optimizeContentImages } from '@/lib/image-transform';
import { and, eq, inArray } from 'drizzle-orm';
import type { ThemeIndexProps, PostListItem } from '@/lib/theme-props';
import { buildCategoryLink } from '@/lib/content';
import NotFound from './NotFound.astro';
import WarmShell from './WarmShell.astro';
import WarmStreamPagination from './WarmStreamPagination.astro';
import WarmNoteMedia from './WarmNoteMedia.astro';
import { formatWarmDate, plainExcerpt, warmSettings } from './warm';

type Props = ThemeIndexProps;
type WarmPostItem = {
  type: 'post';
  cid: number;
  title: string;
  permalink: string;
  excerpt: string;
  created: number;
  categories: PostListItem['categories'];
};
type WarmNoteItem = NoteListItem & { type: 'note' };

const {
  options, urls, pages, sidebarData, currentPath, pluginCtx,
  posts, pagination,
} = Astro.props;

const notesEnabled = pluginCtx.activatedPlugins.has('typecho-plugin-notes');
const requestedStream = Astro.url.searchParams.get('stream');
const topic = Astro.url.searchParams.get('topic');
const stream = !notesEnabled
  ? 'posts'
  : topic || requestedStream === 'notes'
    ? 'notes'
    : requestedStream === 'posts'
      ? 'posts'
      : 'mixed';

const corePosts = new Map(posts.map(post => [Number(post.cid), post]));
const toCoreItem = (post: PostListItem): WarmPostItem => ({
  type: 'post',
  cid: post.cid,
  title: post.title,
  permalink: post.permalink,
  excerpt: plainExcerpt(post.excerpt),
  created: post.created,
  categories: post.categories,
});

let items: Array<WarmPostItem | WarmNoteItem> = posts.map(toCoreItem);
let currentPage = pagination.currentPage;
let hasPrev = pagination.hasPrev;
let hasNext = pagination.hasNext;

if (notesEnabled && stream !== 'posts') {
  const noteContext = await createContext(Astro.locals, Astro.request);
  const notesDb = noteContext.db ?? getDb(env.DB);
  const result = await getNotesStreamForTheme(
    notesDb,
    stream,
    {
      page: pagination.currentPage,
      pageSize: pagination.pageSize,
      topic,
    },
    { siteUrl: urls.siteUrl, permalinkPattern: options.permalinkPattern },
  );
  const mixedPostIds = result
    .items.filter((item): item is NoteListItem & { type: 'post' } => item.type === 'post')
    .map(item => Number(item.cid))
    .filter(cid => Number.isSafeInteger(cid) && !corePosts.has(cid));
  const mixedCategories = new Map<number, PostListItem['categories']>();
  if (mixedPostIds.length > 0) {
    const categoryRows = await notesDb
      .select({
        cid: schema.relationships.cid,
        name: schema.metas.name,
        slug: schema.metas.slug,
      })
      .from(schema.relationships)
      .innerJoin(schema.metas, eq(schema.relationships.mid, schema.metas.mid))
      .where(and(
        inArray(schema.relationships.cid, mixedPostIds),
        eq(schema.metas.type, 'category'),
      ));
    for (const row of categoryRows) {
      const cid = Number(row.cid);
      if (!Number.isSafeInteger(cid)) continue;
      const categories = mixedCategories.get(cid) || [];
      categories.push({
        name: row.name || '',
        slug: row.slug || '',
        permalink: buildCategoryLink(
          row.slug || '',
          urls.siteUrl,
          options.categoryPattern as string | undefined,
        ),
      });
      mixedCategories.set(cid, categories);
    }
  }
  items = result.items.map(item => {
    if (item.type === 'note') return item as WarmNoteItem;
    const cid = Number(item.cid);
    const core = corePosts.get(cid);
    return core ? toCoreItem(core) : {
      type: 'post',
      cid: item.cid,
      title: item.title,
      permalink: item.permalink,
      excerpt: plainExcerpt(item.source),
      created: item.created,
      categories: mixedCategories.get(cid) || [],
    };
  });
  currentPage = result.pagination.page;
  hasPrev = result.pagination.hasPrev;
  hasNext = result.pagination.hasNext;
}

const activeSection = stream === 'notes' ? 'notes' : stream === 'posts' ? 'articles' : 'home';
const heading = stream === 'notes' ? '笔记' : stream === 'posts' ? '文章' : '';
const settings = warmSettings(options);
const baseUrl = `${urls.siteUrl.replace(/\/$/, '')}/`;
const pageUrl = (page: number) => {
  const params = new URLSearchParams();
  if (stream !== 'mixed') params.set('stream', stream);
  if (topic) params.set('topic', topic);
  const path = page > 1 ? `page/${page}/` : '';
  const query = params.toString();
  return `${baseUrl}${path}${query ? `?${query}` : ''}`;
};
const isNotesStreamOutOfRange = notesEnabled && stream !== 'posts' && currentPage > 1 && items.length === 0;
if (isNotesStreamOutOfRange) Astro.response.status = 404;
---
{isNotesStreamOutOfRange ? (
  <NotFound
    options={options}
    urls={urls}
    pages={pages}
    sidebarData={sidebarData}
    currentPath={currentPath}
    pluginCtx={pluginCtx}
    statusCode={404}
    errorTitle="404 - 页面没找到"
  />
) : (
  <WarmShell
  options={options}
  urls={urls}
  pages={pages}
  sidebarData={sidebarData}
  currentPath={currentPath}
  pluginCtx={pluginCtx}
  section={activeSection}
  title={heading || undefined}
>
  {stream === 'notes' && topic && (
    <div class="warm-topic-filter">
      <span>话题：#{topic}</span>
      <a href={`${baseUrl}?stream=notes`}>清除筛选</a>
    </div>
  )}

  <div class="warm-stream" data-warm-stream>
    {items.length === 0 ? (
      <section class="warm-empty">
        <h1>这里还很安静</h1>
        <p>{stream === 'notes' ? '暂时没有符合条件的笔记。' : '第一篇文章正在路上。'}</p>
      </section>
    ) : items.map(item => item.type === 'note' ? (
      <article class="warm-stream-item warm-note" data-content-type="note">
        <a class="warm-stream-item__hit" href={item.permalink} aria-label="查看这则笔记"></a>
        <div class="warm-item-meta">
          <span class="warm-note-label">笔记</span>
          <span aria-hidden="true">·</span>
          <time datetime={new Date(item.created * 1000).toISOString()}>{formatWarmDate(item.created, options.postDateFormat, options.timezone, true)}</time>
        </div>
        <div class="warm-note__content" set:html={optimizeContentImages(item.html, settings.imageOptimizeParams, urls.siteUrl)} />
        <WarmNoteMedia
          note={item}
          optimizeParams={settings.imageOptimizeParams}
          thumbParams={settings.thumbOptimizeParams}
          siteUrl={urls.siteUrl}
        />
      </article>
    ) : (
      <article class="warm-stream-item warm-post-card" data-content-type="post">
        <a class="warm-stream-item__hit" href={item.permalink} aria-label={`阅读：${item.title}`}></a>
        <div class="warm-item-meta">
          {item.categories[0] ? <a class="warm-category" href={item.categories[0].permalink}>{item.categories[0].name}</a> : null}
          {item.categories[0] ? <span aria-hidden="true">·</span> : null}
          <time datetime={new Date(item.created * 1000).toISOString()}>{formatWarmDate(item.created, options.postDateFormat, options.timezone)}</time>
        </div>
        <h2><a href={item.permalink}>{item.title}</a></h2>
        {item.excerpt && <p>{item.excerpt}</p>}
        <a class="warm-read-more" href={item.permalink}>阅读全文 <span aria-hidden="true">→</span></a>
      </article>
    ))}
  </div>

  <WarmStreamPagination
    hasPrev={hasPrev}
    hasNext={hasNext}
    prevUrl={hasPrev ? pageUrl(currentPage - 1) : null}
    nextUrl={hasNext ? pageUrl(currentPage + 1) : null}
    mode={settings.continuousLoadMode}
    label="内容分页"
  />
  </WarmShell>
)}
