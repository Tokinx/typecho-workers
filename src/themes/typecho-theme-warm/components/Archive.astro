---
import type { ThemeArchiveProps } from '@/lib/theme-props';
import WarmShell from './WarmShell.astro';
import WarmStreamPagination from './WarmStreamPagination.astro';
import { formatWarmDate, plainExcerpt, warmSettings } from './warm';

type Props = ThemeArchiveProps;
const {
  options, urls, pages, sidebarData, currentPath, pluginCtx,
  archiveTitle, posts, pagination,
} = Astro.props;
const settings = warmSettings(options);
---
<WarmShell
  title={archiveTitle}
  options={options}
  urls={urls}
  pages={pages}
  sidebarData={sidebarData}
  currentPath={currentPath}
  pluginCtx={pluginCtx}
  section="articles"
>
  <div class="warm-stream" data-warm-stream>
    {posts.length > 0 ? posts.map(post => (
      <article class="warm-stream-item warm-post-card">
        <a class="warm-stream-item__hit" href={post.permalink} aria-label={`阅读：${post.title}`}></a>
        <div class="warm-item-meta">
          <time datetime={new Date(post.created * 1000).toISOString()}>{formatWarmDate(post.created, options.postDateFormat, options.timezone)}</time>
          {post.categories[0] ? <span aria-hidden="true">·</span> : null}
          {post.categories[0] ? <a class="warm-category" href={post.categories[0].permalink}>{post.categories[0].name}</a> : null}
        </div>
        <h2><a href={post.permalink}>{post.title}</a></h2>
        <p>{plainExcerpt(post.excerpt)}</p>
      </article>
    )) : <section class="warm-empty"><h2>没有找到内容</h2><p>换个分类或关键词再看看。</p></section>}
  </div>

  <WarmStreamPagination
    hasPrev={pagination.hasPrev}
    hasNext={pagination.hasNext}
    prevUrl={pagination.prevUrl}
    nextUrl={pagination.nextUrl}
    mode={settings.continuousLoadMode}
    label="归档分页"
  />
</WarmShell>
