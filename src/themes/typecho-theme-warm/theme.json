{
  "id": "typecho-theme-warm",
  "name": "Typecho Warm",
  "description": "静谧温润的单栏写作主题，支持文章与笔记混合时间线。",
  "author": "Tokinx",
  "version": "1.0.0",
  "stylesheet": "style.css",
  "homepage": "https://github.com/Tokinx/typecho-workers/tree/master/src/themes/typecho-theme-warm",
  "license": "MIT",
  "commentsMode": "api",
  "tags": ["warm", "minimal", "notes", "single-column"],
  "config": {
    "githubUrl": {
      "type": "text",
      "label": "GitHub 地址",
      "default": ""
    },
    "socialUrl": {
      "type": "text",
      "label": "社交主页地址",
      "default": ""
    },
    "email": {
      "type": "text",
      "label": "联系邮箱",
      "default": ""
    },
    "continuousLoadMode": {
      "type": "select",
      "label": "连续加载",
      "description": "控制首页、分类和笔记列表后续页的加载方式。",
      "default": "manual",
      "options": {
        "manual": "手动加载",
        "auto-2": "自动加载 2 次",
        "infinite": "无限自动加载"
      }
    },
    "commentInitialLoadMode": {
      "type": "select",
      "label": "评论列表首次加载",
      "default": "auto-first",
      "options": {
        "manual": "手动加载评论列表",
        "auto-first": "自动加载第一页",
        "dwell": "停留 3 秒加载",
        "dwell-auto-2": "停留 3 秒加载（后续自动加载 2 次）",
        "infinite": "无限自动加载"
      }
    }
  }
}
