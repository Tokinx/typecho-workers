{
  "id": "typecho-theme-warm",
  "name": "Typecho Warm",
  "description": "静谧温润的单栏写作主题，支持文章与笔记混合时间线。",
  "author": "Typecho-CF",
  "version": "1.0.0",
  "stylesheet": "style.css",
  "homepage": "https://github.com/eslizn/typecho-cf",
  "license": "MIT",
  "commentsMode": "api",
  "tags": ["warm", "minimal", "notes", "single-column"],
  "config": {
    "githubUrl": {
      "type": "text",
      "label": "GitHub 地址",
      "default": ""
    },
    "socialUrl": {
      "type": "text",
      "label": "社交主页地址",
      "default": ""
    },
    "email": {
      "type": "text",
      "label": "联系邮箱",
      "default": ""
    },
    "continuousLoadMode": {
      "type": "select",
      "label": "连续加载",
      "description": "控制首页、归档、笔记和评论后续页的加载方式。",
      "default": "manual",
      "options": {
        "manual": "手动加载",
        "auto-3": "自动加载 3 次，之后手动加载",
        "infinite": "无限自动加载"
      }
    },
    "commentInitialLoadMode": {
      "type": "select",
      "label": "评论列表首次加载",
      "default": "auto",
      "options": {
        "manual": "手动加载评论列表",
        "dwell": "停留在评论区 3 秒后加载",
        "auto": "自动加载评论列表"
      }
    }
  }
}
