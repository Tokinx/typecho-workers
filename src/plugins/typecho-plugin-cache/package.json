{
  "name": "typecho-plugin-cache",
  "version": "1.0.0",
  "description": "Cloudflare Cache API + KV + D1 edge page cache and CDN URL rewriting for Typecho-Workers.",
  "keywords": ["typecho", "plugin", "cache", "kv", "cdn"],
  "author": "Tokinx",
  "license": "MIT",
  "type": "module",
  "main": "index.ts",
  "typecho": {
    "plugin": {
      "id": "typecho-plugin-cache",
      "name": "Edge Cache",
      "description": "Cache API L1、KV L2 与 D1 L3 三级页面缓存，并提供静态资源 CDN 改写",
      "adminPage": "cache",
      "earlyRequest": true,
      "author": "Tokinx",
      "version": "1.0.0",
      "homepage": "https://github.com/Tokinx/typecho-workers/tree/master/src/plugins/typecho-plugin-cache",
      "license": "MIT",
      "tags": ["cache", "kv", "cdn"],
      "config": {
        "cacheScopes": {
          "type": "checkbox",
          "label": "缓存范围",
          "default": ["home", "post", "page", "note", "archive", "other"],
          "options": {
            "home": "首页与分页",
            "post": "文章",
            "page": "独立页面",
            "note": "笔记",
            "archive": "分类、标签、作者与搜索",
            "other": "其他公开 HTML"
          },
          "multiline": true
        },
        "l1Ttl": {
          "type": "select",
          "label": "L1 边缘节点缓存",
          "default": "604800",
          "options": { "0": "不缓存", "3600": "1 小时", "43200": "12 小时", "86400": "1 天", "259200": "3 天", "604800": "7 天", "2592000": "30 天" }
        },
        "l2Ttl": {
          "type": "select",
          "label": "L2 KV 缓存",
          "default": "259200",
          "options": { "0": "不缓存", "86400": "1 天", "259200": "3 天", "604800": "7 天" }
        },
        "l3Ttl": {
          "type": "select",
          "label": "L3 D1 KV 缓存",
          "default": "21600",
          "options": { "0": "不缓存", "300": "5 分钟", "3600": "1 小时", "21600": "6 小时", "43200": "12 小时", "86400": "1 天" }
        },
        "frontendDataCacheBackend": {
          "type": "select",
          "label": "前台数据缓存后端",
          "description": "用于站点选项、导航、侧栏、元数据、评论、笔记、公开归档和内容。登录用户的前台权限裁剪结果也会写入所选后端。",
          "default": "kv",
          "options": { "kv": "Cloudflare KV", "d1": "D1 KV" }
        },
        "adminDataCacheBackend": {
          "type": "select",
          "label": "后台数据缓存后端",
          "description": "用于仪表盘及后台的内容、评论、分类标签、媒体、用户和只读选项列表。登录用户结果会按已验证身份隔离后写入所选后端。",
          "default": "kv",
          "options": { "kv": "Cloudflare KV", "d1": "D1 KV" }
        },
        "bypassCookieNames": {
          "type": "textarea",
          "label": "额外绕过 Cookie 名称",
          "default": "",
          "description": "按 Cookie 名精确匹配，多个名称使用英文逗号或换行分隔"
        },
        "staticCdnUrl": {
          "type": "text",
          "label": "静态文件 CDN",
          "default": "",
          "description": "用于加速页面静态文件"
        },
        "staticExtensions": {
          "type": "text",
          "label": "静态文件支持格式",
          "default": "jpg,jpeg,png,gif,webp,avif,svg,ico,css,js,mjs,woff,woff2,ttf,mp3,mp4,zip,rar,7z,pdf",
          "description": "使用英文逗号分隔"
        },
        "avatarCdnUrl": {
          "type": "text",
          "label": "Gravatar CDN",
          "default": "",
          "description": "用于加速 Gravatar 头像服务"
        }
      }
    }
  }
}
